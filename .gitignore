# Local configuration & secrets
.env
.env.*
# ...but the deployment template is documentation, not configuration. It holds
# only defaults and empty placeholders, and `.env.*` had silently kept it out
# of the repository while deploy/README.md and DEC-065 both pointed at it.
!deploy/.env.example
.secrets
secrets/
*.pem
*.key
*.cert
credentials.json

# Image Platform Specific Exclusions
# Never commit real, uploaded, intermediate, or processed photographs
uploads/
tmp/
temp/
*test_uploads/
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.tiff
*.bmp

# Deliberate exceptions to the blanket image ban above. The ban exists to stop
# a real candidate's photograph ever reaching version control, and it stays.
# None of these is a candidate photograph:
#
#   assets/reference-portrait.jpg        the ideal-photo source, a synthetic face
#   apps/web/public/examples/*           guidance examples served by the web app
#   apps/web/public/examples/band/*      the landing band's before-and-after
#                                        pairs: generated people and invented
#                                        signatures, recorded in
#                                        docs/ui-direction-2026-09-10/DEMO_ASSETS.md
#
# These MUST be tracked: they are served by the web app, so a clone without
# them builds a site whose images are all broken -- which is exactly what
# happened before this exception was added, and it passed locally because the
# files were present on the machine that generated them. Note the per-directory
# globs: `examples/*.jpg` does not reach `examples/demo/`, and adding the demo
# pairs without the second line silently shipped a band with no pictures in it.
!assets/reference-portrait.jpg
!apps/web/public/examples/*.jpg
!apps/web/public/examples/*.png
!apps/web/public/examples/*.webp
!apps/web/public/examples/band/*.jpg
!apps/web/public/examples/band/*.png
# The application's own icons: drawn from the wordmark's tick by
# scripts, served to the home screen, and not a photograph of anybody.
!apps/web/public/icon-192.png
!apps/web/public/icon-512.png
!apps/web/public/icon-maskable-512.png
!apps/web/src/app/icon.png
!apps/web/src/app/apple-icon.png
# The stacked ExamUploadKit logo (the owner's point H, DEC-094), rendered from
# the wordmark by apps/web/scripts/render-stacked-logo.mjs. Built on 14
# September but never committed, because the image ban above ate it.
!apps/web/public/brand/*.png
!apps/web/public/brand/*.jpg
# Ignore generated outputs
output/
downloads/
*.metadata.json
quality_contact_sheet.html
# Ignore model weight files and caches
/model-assets/
/model-cache/
weights/
.cache/
model_cache/
# MediaPipe and other ML framework model asset files
# These are large binary operator-acquired assets — never commit to VCS
*.task
*.tflite

# Exceptions: Allow intentionally committed documentation PDFs and fictional examples
!docs/source/*.pdf
!examples/rules/*.json
!tests/fixtures/*.png
!tests/fixtures/*.jpg
!tests/fixtures/*.jpeg
!tests/fixtures/segmentation/masks/*.png
!tests/fixtures/segmentation/refined_masks/*.png
!tests/fixtures/segmentation/reference_masks/*.png
!tests/golden-images/*.png
!tests/golden-images/*.jpg
!tests/golden-images/*.jpeg

# Databases & logs
*.db
*.sqlite3
*.log
signed_urls.log
private_metadata_export.json

# Local scratch: holds processed real candidate photos and downloaded models.
# Never commit these (AGENTS.md privacy rule).
/.tmp/
/services/image-engine/.tmp/
/.venv-local/

# Private local candidate-request queue
/apps/web/.data/

# Agent design tooling — installed per machine, never committed.
# 15 MB windows-x64 binaries duplicated across three harness dirs, and
# platform-specific, so they are useless to CI or a non-Windows collaborator.
# skills-lock.json pins the versions; docs/DESIGN_TOOLING.md has the commands.
/.agents/
/.claude/skills/
/.claude/agents/
/.github/skills/
/.github/agents/
/.github/hooks/
/.codex/

# impeccable per-machine overrides
/.impeccable/config.local.json
