# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
.project
.pydevproject
.settings/

# Local configuration & secrets
.env
.env.*
.secrets
secrets/
*.pem
*.key
*.cert
credentials.json

# Image Platform Specific Exclusions
# Never commit real, uploaded, intermediate, or processed photographs
uploads/
tmp/
temp/
*test_uploads/
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.tiff
*.bmp

# Two deliberate exceptions to the blanket image ban above. The ban exists to
# stop a real candidate's photograph ever reaching version control, and it
# stays. Neither of these is a candidate photograph:
#
#   assets/reference-portrait.jpg   the ideal-photo source, a synthetic face
#   apps/web/public/examples/*      the accepted/rejected examples derived from
#                                   it by scripts/generate_guidance_examples.py
#
# These MUST be tracked: they are served by the web app, so a clone without
# them builds a site whose guidance images are all broken -- which is exactly
# what happened before this exception was added, and it passed locally because
# the files were present on the machine that generated them.
!assets/reference-portrait.jpg
!apps/web/public/examples/*.jpg
!apps/web/public/examples/*.png
!apps/web/public/examples/*.webp
# Ignore generated outputs
output/
downloads/
*.metadata.json
quality_contact_sheet.html
# Ignore model weight files and caches
/model-assets/
/model-cache/
weights/
.cache/
model_cache/
# MediaPipe and other ML framework model asset files
# These are large binary operator-acquired assets — never commit to VCS
*.task
*.tflite

# Exceptions: Allow intentionally committed documentation PDFs and fictional examples
!docs/source/*.pdf
!examples/rules/*.json
!tests/fixtures/*.png
!tests/fixtures/*.jpg
!tests/fixtures/*.jpeg
!tests/fixtures/segmentation/masks/*.png
!tests/fixtures/segmentation/refined_masks/*.png
!tests/fixtures/segmentation/reference_masks/*.png
!tests/golden-images/*.png
!tests/golden-images/*.jpg
!tests/golden-images/*.jpeg

# Databases & logs
*.db
*.sqlite3
*.log
signed_urls.log
private_metadata_export.json

# Local scratch: holds processed real candidate photos and downloaded models.
# Never commit these (AGENTS.md privacy rule).
/.tmp/
/services/image-engine/.tmp/
/.venv-local/
