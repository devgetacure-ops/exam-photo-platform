# Copy to deploy/.env and fill in. Everything here is off or permissive by
# default so local development is unchanged; a public host must set all of it.

# ---------------------------------------------------------------------------
# The domain. ":80" serves plain HTTP for a local trial. Set it to your
# hostname and Caddy obtains and renews a TLS certificate on its own.
# ---------------------------------------------------------------------------
SITE_ADDRESS=:80

# ---------------------------------------------------------------------------
# The operator surface (DEC-064). Gates /v1/process, /v1/rules/validate,
# /v1/cleanup-expired and /test -- routes no candidate touches and where the
# damage is asymmetric. Leaving it empty leaves them open; `GET /ready` then
# reports operator_surface: "unauthenticated".
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
EXAM_PHOTO_OPERATOR_TOKEN=

# ---------------------------------------------------------------------------
# Sizing. Each worker holds its own warm BiRefNet session at roughly 2.4 GB
# resident, peaking near 2.9 GB during inference -- measured, not estimated.
# Workers are processes, so the cost is per worker and not shared.
#   1 worker  -> 4 GB box
#   2 workers -> 8 GB box
# Concurrency is per process and bounded by CPU, not memory; set it to about
# the core count divided by the worker count, then measure.
# ---------------------------------------------------------------------------
EXAM_PHOTO_WORKERS=1
ENGINE_MEM_LIMIT=4g
EXAM_PHOTO_MAX_CONCURRENT_PREPARATIONS=2

# ---------------------------------------------------------------------------
# Retention. Thirty minutes, settled by DEC-066 and published as a deletion
# guarantee -- so **this number is a promise, not a tuning knob**. Access ends
# at exactly the deadline (the read path checks it), and the sweep interval
# below decides only how promptly the bytes of a job nobody came back for
# leave the disk. Lengthening either one breaks a claim the product makes.
# ---------------------------------------------------------------------------
EXAM_PHOTO_JOB_TTL_SECONDS=1800
EXAM_PHOTO_CLEANUP_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Uploads.
# ---------------------------------------------------------------------------
EXAM_PHOTO_MAX_UPLOAD_BYTES=5242880
EXAM_PHOTO_MAX_DOCUMENT_FILES=20

# ---------------------------------------------------------------------------
# CORS. Leave BOTH of these unset for the compose deployment: the proxy serves
# the app and the API from one origin, so there is no cross-origin request to
# permit. Set EXAM_PHOTO_ALLOWED_ORIGINS only if you split them onto separate
# hostnames.
# ---------------------------------------------------------------------------
# EXAM_PHOTO_ALLOWED_ORIGINS=https://examupload.in
# NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# The purchase gate (DEC-063). On by default. Setting this to false serves
# clean files to anyone holding a job id -- only ever do that locally, to
# judge engine output quality.
# ---------------------------------------------------------------------------
EXAM_PHOTO_PURCHASE_GATE_ENABLED=true
