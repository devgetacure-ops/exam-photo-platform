# Copy to deploy/.env and fill in. Everything here is off or permissive by
# default so local development is unchanged; a public host must set all of it.

# ---------------------------------------------------------------------------
# The domain. ":80" serves plain HTTP for a local trial. Set it to your
# hostname and Caddy obtains and renews a TLS certificate on its own.
# ---------------------------------------------------------------------------
SITE_ADDRESS=:80
# On a real domain (DEC-097), for example:
#   SITE_ADDRESS=examuploadkit.com
#   WWW_ADDRESS=www.examuploadkit.com
#   CANONICAL_ORIGIN=https://examuploadkit.com
WWW_ADDRESS=http://www.localhost
CANONICAL_ORIGIN=http://localhost

# ---------------------------------------------------------------------------
# The web app (DEC-097). Read when the image is built, because Next.js writes
# NEXT_PUBLIC_* into the pages: change one, then `up -d --build`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile's site key (the secret goes in EXAM_PHOTO_TURNSTILE_SECRET).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Web Analytics: cookieless visit counts. Empty loads nothing.
NEXT_PUBLIC_CF_BEACON_TOKEN=
# Search Console and Bing Webmaster Tools ownership tags (the content value only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# The seller details the support and policy pages show (DEC-086). They live
# here, on the server, and never in git.
EUK_BUSINESS_PHONE=
EUK_BUSINESS_HOURS=
EUK_BUSINESS_PUBLIC_ADDRESS=

# ---------------------------------------------------------------------------
# The operator surface (DEC-064). Gates /v1/process, /v1/rules/validate,
# /v1/cleanup-expired and /test -- routes no candidate touches and where the
# damage is asymmetric. Leaving it empty leaves them open; `GET /ready` then
# reports operator_surface: "unauthenticated".
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
EXAM_PHOTO_OPERATOR_TOKEN=
# The operator page at /admin (DEC-108). Both come from the Cloudflare Access
# application protecting /admin; without them the page answers 404 to everyone.
EUK_ACCESS_TEAM_DOMAIN=
EUK_ACCESS_AUD=

# The back office, Releases 2 and 3 (DEC-110, DEC-111). All optional.
# A price test: the second arm's ladder in paise, and the share of sessions (0-100) that see it.
EXAM_PHOTO_PRICE_TEST_LADDER=
EXAM_PHOTO_PRICE_TEST_SHARE=0
# Signs unsubscribe and "did it work?" links. Falls back to the operator token.
#   openssl rand -hex 32
EXAM_PHOTO_LINK_SECRET=

# ---------------------------------------------------------------------------
# Sizing. Each worker holds its own warm BiRefNet session at roughly 2.4 GB
# resident, peaking near 2.9 GB during inference -- measured, not estimated.
# Workers are processes, so the cost is per worker and not shared.
#   1 worker  -> 4 GB box
#   2 workers -> 8 GB box
# Concurrency is per process and bounded by CPU, not memory; set it to about
# the core count divided by the worker count, then measure.
# ---------------------------------------------------------------------------
EXAM_PHOTO_WORKERS=1
ENGINE_MEM_LIMIT=4g
EXAM_PHOTO_MAX_CONCURRENT_PREPARATIONS=2

# ---------------------------------------------------------------------------
# Retention. Thirty minutes, settled by DEC-066 and published as a deletion
# guarantee -- so **this number is a promise, not a tuning knob**. Access ends
# at exactly the deadline (the read path checks it), and the sweep interval
# below decides only how promptly the bytes of a job nobody came back for
# leave the disk. Lengthening either one breaks a claim the product makes.
# ---------------------------------------------------------------------------
EXAM_PHOTO_JOB_TTL_SECONDS=1800
EXAM_PHOTO_CLEANUP_INTERVAL_SECONDS=300

# The ceiling a candidate's own extensions cannot pass (DEC-067), measured
# from when the job was created. 3600 is what every file used to get
# unconditionally, so extension cannot lengthen the worst case beyond what the
# product already shipped. Whatever you set here is part of the published
# claim too: "deleted in 30 minutes" beside an hour-long ceiling is false.
EXAM_PHOTO_JOB_MAX_LIFETIME_SECONDS=3600

# ---------------------------------------------------------------------------
# Uploads.
# ---------------------------------------------------------------------------
EXAM_PHOTO_MAX_UPLOAD_BYTES=5242880
EXAM_PHOTO_MAX_DOCUMENT_FILES=20
EXAM_PHOTO_MAX_EMAIL_DELIVERY_ATTEMPTS_PER_JOB=3

# ---------------------------------------------------------------------------
# CORS. Leave BOTH of these unset for the compose deployment: the proxy serves
# the app and the API from one origin, so there is no cross-origin request to
# permit. Set EXAM_PHOTO_ALLOWED_ORIGINS only if you split them onto separate
# hostnames.
# ---------------------------------------------------------------------------
# EXAM_PHOTO_ALLOWED_ORIGINS=https://examupload.in
# NEXT_PUBLIC_EXAM_PHOTO_API_BASE_URL=

# ---------------------------------------------------------------------------
# The purchase gate (DEC-063). On by default. Setting this to false serves
# clean files to anyone holding a job id -- only ever do that locally, to
# judge engine output quality.
# ---------------------------------------------------------------------------
EXAM_PHOTO_PURCHASE_GATE_ENABLED=true

# ---------------------------------------------------------------------------
# Payments (DEC-069). The Razorpay webhook's shared secret, copied from the
# Razorpay dashboard when you create the webhook. Empty means the webhook
# route refuses every request, so with the gate on above, **nothing can ever
# be released** -- a deployment that looks healthy and cannot take money.
# `GET /ready` reports `payments: configured` once this is set.
#
# Point the Razorpay webhook at https://<your-domain>/v1/payments/razorpay/webhook
# and subscribe to `payment.captured` and `order.paid` only.
#
# Underpayment is closed by DEC-070: orders are created server-side at a price
# the service computes, and Razorpay guarantees a payment matches its order, so
# a verified event for an order we created is proof of our amount. That holds
# only while the browser never creates an order -- see the two keys below.
# ---------------------------------------------------------------------------
EXAM_PHOTO_RAZORPAY_WEBHOOK_SECRET=

# Razorpay API credentials, used to create orders server-side at a price the
# service computes (DEC-070). KEY_ID is publishable and is handed to the
# browser for Checkout; KEY_SECRET never leaves the process. Both empty means
# order creation refuses, so a host without them cannot fall back to a
# browser-supplied amount.
EXAM_PHOTO_RAZORPAY_KEY_ID=
EXAM_PHOTO_RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Email delivery (DEC-072). Lets a paid file outlive the thirty-minute
# retention window: the candidate keeps the attachment after our copy is
# erased. An empty host or sender means email delivery refuses rather than
# reporting a success it did not achieve, so the interface can tell the
# candidate honestly that only download is available.
#
# The candidate's address is used and not stored. Only a masked form is kept.
# ---------------------------------------------------------------------------
EXAM_PHOTO_SMTP_HOST=
EXAM_PHOTO_SMTP_PORT=587
EXAM_PHOTO_SMTP_USERNAME=
EXAM_PHOTO_SMTP_PASSWORD=
EXAM_PHOTO_SMTP_FROM=
EXAM_PHOTO_SMTP_USE_TLS=true
# How the message presents itself (DEC-102). The inbox shows FROM_NAME beside
# the address; a candidate's reply goes to REPLY_TO, which the email also names
# as the support address; SITE_URL is linked from its header and footer. Each
# is optional: empty sends no Reply-To and links nothing.
EXAM_PHOTO_SMTP_FROM_NAME=ExamUploadKit
EXAM_PHOTO_SMTP_REPLY_TO=
EXAM_PHOTO_SITE_URL=

# ---------------------------------------------------------------------------
# Protecting capacity (DEC-073). The threat is not the money -- a hundred free
# preparations cost about a rupee of a VPS you already pay for -- it is a
# script saturating the queue on a deadline day, when a refused candidate is a
# lost sale.
#
# Turnstile is the control that matters, because automated abuse is the only
# kind with the volume. Create a widget at dash.cloudflare.com, put the site
# key in the front end and the secret here. It fails OPEN if Cloudflare is
# unreachable: refusing every candidate over a third-party outage costs more
# than the CPU it would save.
EXAM_PHOTO_TURNSTILE_SECRET=

# Free preparations per kit before a purchase is required. 0 = no limit, and
# that is the right setting until `GET /v1/metrics/usage` says what a real
# candidate does -- a limit set too low loses sales silently. It is a speed
# bump for idle re-uploading, not a security control: kit_id is minted by the
# browser and clearing storage resets it. The challenge above is what stops a
# script.
EXAM_PHOTO_FREE_PREPARATION_ALLOWANCE=0
