# One origin for both halves, which is why the engine needs no CORS at all
# (DEC-064/DEC-065). The browser calls /v1/... on the page's own host; Caddy
# decides which container answers.
#
# SITE_ADDRESS is ":80" by default for a local trial. Set it to your domain in
# .env and Caddy obtains and renews a certificate on its own.

# www.<domain> answers with a permanent redirect to <domain> (DEC-097), so a
# search engine indexes one address and a link someone types with "www" still
# lands. A local trial leaves WWW_ADDRESS at a name that never resolves.
{$WWW_ADDRESS} {
	redir {$CANONICAL_ORIGIN}{uri} permanent
}

{$SITE_ADDRESS} {
	encode gzip

	# An upload is bounded at the edge as well as in the application. The
	# engine caps each file at 5 MB and a document at 20 files; this stops a
	# body larger than that ever being read into the process.
	request_body {
		max_size 110MB
	}

	header {
		# The clean file is sold and the preview is a candidate's face.
		# Neither should be framed, sniffed, or leak a full referrer.
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# A candidate who has once arrived over HTTPS never tries port 80
		# again, so a network between them and us cannot offer them a
		# plain-text version of a page they are about to pay on. Two years,
		# subdomains included; not submitted to the preload list, which is
		# far harder to leave than to join (DEC-106).
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Nothing here needs a microphone, a location or a payment handler of
		# its own: Razorpay's window brings its own. The camera stays for the
		# file picker's capture.
		Permissions-Policy "accelerometer=(), camera=(self), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		# Reported, not enforced, until the live pages are watched for a week:
		# a wrong rule here would break checkout, which is worse than the
		# injection it guards against. The list is what the site actually
		# loads -- Razorpay's checkout, Turnstile, Cloudflare's counter and
		# Google's fonts.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.razorpay.com; connect-src 'self' https://*.razorpay.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://*.razorpay.com https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# --- probes, first ----------------------------------------------------
	# Ordering is load-bearing: `handle` blocks are evaluated in order, so
	# this must precede the /v1 block or the engine matcher swallows these two
	# paths and the restriction below never runs.
	#
	# `/ready` reports the matting backend, the purchase-gate state and
	# whether the operator surface is authenticated. That is exactly the
	# reconnaissance an attacker wants, so it is answered only on a private
	# network -- a load balancer or another container still reaches it.
	@probes path /health /ready
	handle @probes {
		@public not remote_ip private_ranges
		respond @public 404
		reverse_proxy engine:8000
	}

	# --- the engine -------------------------------------------------------
	@engine path /v1/* /test
	handle @engine {
		reverse_proxy engine:8000 {
			# The pipeline is ~10 s per photograph and the first request after
			# a restart is far longer, so this is set above both. nginx's 60 s
			# default is what would otherwise cut a healthy preparation in
			# half and report it as a gateway error.
			transport http {
				read_timeout 180s
			}
		}
	}

	# --- the app ----------------------------------------------------------
	handle {
		reverse_proxy web:3000
	}
}
